filters:
  and:
    - file.name != "index"
    - file.name != "404"
    - file.name != "support"
    - file.ext == "md"
properties:
  title:
    displayName: タイトル
  created:
    displayName: 日付
  file.tags:
    displayName: タグ
views:
  - type: table-tags
    name: "2026"
    filters:
      and:
        - created >= "2026-01-01"
    order:
      - created
      - title
      - file.tags
    sort:
      - property: created
        direction: DESC
